# ==============================================================================
# PropertyOS Environment Configuration (Template)
# ==============================================================================
# IMPORTANT: Copy this file to .env and configure real local/production values.
# NEVER commit .env to version control or expose backend secrets to the frontend.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/propertyos?schema=public"

# Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
# Generate secure random strings in production (e.g., openssl rand -hex 32)
JWT_SECRET="change-me-to-a-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-me-to-a-super-secret-refresh-key-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"
SESSION_SECRET="change-me-to-a-super-secret-session-cookie-key"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# Rate Limiting Defaults
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_TTL=900

# CORS Allowed Origins (Comma-separated for multiple origins, NO WILDCARD in production)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Storage Configuration (Google Cloud Storage / Local Fallback)
# Set to 'local' for zero-cost offline local development, 'gcs' for production
STORAGE_DRIVER="local"
LOCAL_UPLOAD_PATH="./uploads"
GCS_PROJECT_ID=""
GCS_BUCKET_NAME=""
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""

# Public Frontend Variables (MUST NOT contain sensitive credentials)
NEXT_PUBLIC_APP_NAME="PropertyOS"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
