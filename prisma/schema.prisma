// ==============================================================================
// PropertyOS — Core Database Schema (PostgreSQL + Prisma ORM)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum PropertyType {
  PG
  RENTAL_HOUSE
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  ARCHIVED
}

enum UserRoleType {
  OWNER
  PROPERTY_MANAGER
  ACCOUNTANT
  WARDEN
  SECURITY
  MAINTENANCE_STAFF
  TENANT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum RoomSharingType {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR_SHARING
  DORMITORY
}

enum BedStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  CLEANING
  NOTICE
  BLOCKED
}

enum RentalUnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  NOTICE
  EXPIRED
  TERMINATED
}

enum TenantStatus {
  PROSPECT
  ACTIVE
  NOTICE
  CHECKED_OUT
  ARCHIVED
}

enum KycDocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  EMPLOYMENT_ID
  STUDENT_ID
  RENTAL_AGREEMENT
  POLICE_VERIFICATION
  OTHER
}

enum KycVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CheckInStatus {
  INITIATED
  READY
  CHECKED_IN
  CANCELLED
}

enum CheckoutStatus {
  INITIATED
  SETTLEMENT_PENDING
  READY
  COMPLETED
  CANCELLED
}

enum SettlementStatus {
  DRAFT
  FINALIZED
  VOID
}

enum AgreementStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER_NEFT_IMPS
  CREDIT_CARD
  DEBIT_CARD
  CASH
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  CLEANING
  FURNITURE
  APPLIANCE
  INTERNET
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CLOSED
  CANCELLED
}

enum ExpenseCategoryType {
  SALARY
  ELECTRICITY
  WATER
  FOOD
  MAINTENANCE
  CLEANING
  INTERNET
  SUPPLIES
  PROPERTY_TAX
  OTHER
}

enum NotificationType {
  RENT_DUE
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  MAINTENANCE_UPDATED
  LEASE_EXPIRING
  CHECKOUT_REMINDER
  VISITOR_REQUEST
  DOCUMENT_EXPIRING
}

// ------------------------------------------------------------------------------
// MULTI-TENANCY & IDENTITY
// ------------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid())
  name        String
  legalName   String?
  taxIdGst    String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users             User[]
  properties        Property[]
  tenants           Tenant[]
  invoices          Invoice[]
  payments          Payment[]
  expenses          ExpenseRecord[]
  auditLogs         AuditLog[]
  staffMembers      StaffMember[]
  agreementTemplates AgreementTemplate[]
  teamInvitations   TeamInvitation[]
  sequences         OrganizationSequence[]
  propertyMedia     PropertyMedia[]
  checkIns          CheckIn[]
  checkouts         Checkout[]
  settlements       Settlement[]

  @@map("organizations")
}

model User {
  id             String    @id @default(uuid())
  organizationId String
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  sessions       Session[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations TeamInvitation[] @relation("SentInvitations")
  auditLogs      AuditLog[]
  staffProfile   StaffMember?
  createdTickets MaintenanceTicket[] @relation("TicketCreator")
  assignedTickets MaintenanceTicket[] @relation("TicketAssignee")
  maintenanceComments MaintenanceComment[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        UserRoleType @unique
  description String?
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model TeamInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           UserRoleType
  tokenHash      String           @unique
  invitedById    String
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([status])
  @@map("team_invitations")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String
  resourceId     String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// PROPERTY MANAGEMENT
// ------------------------------------------------------------------------------

model Property {
  id             String         @id @default(uuid())
  organizationId String
  code           String         // e.g. PROP-000001
  name           String
  propertyType   PropertyType   // PG | RENTAL_HOUSE (immutable)
  status         PropertyStatus @default(ACTIVE)
  description    String?
  address        String
  addressLine1   String?
  addressLine2   String?
  locality       String?
  city           String
  district       String?
  state          String
  country        String         @default("India")
  postalCode     String         // 6-digit Indian PIN code
  latitude       Float?
  longitude      Float?
  contactPhone   String?
  contactEmail   String?
  images         String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amenities      PropertyAmenity[]
  media          PropertyMedia[]
  floors         Floor[]
  rooms          Room[]
  rentalUnits    RentalUnit[]
  meters         Meter[]
  mealPlans      MealPlan[]
  maintenanceTickets MaintenanceTicket[]
  staffMembers   StaffMember[]
  visitors       VisitorRecord[]
  inventoryItems InventoryItem[]
  expenses       ExpenseRecord[]
  invoices       Invoice[]
  communityPosts CommunityPost[]
  serviceRequests ServiceRequest[]
  checkIns       CheckIn[]
  checkouts      Checkout[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, propertyType])
  @@index([organizationId, city])
  @@index([city, propertyType])
  @@index([status])
  @@map("properties")
}

model PropertyMedia {
  id             String   @id @default(uuid())
  propertyId     String
  organizationId String
  fileName       String
  originalName   String
  mimeType       String
  fileSize       Int
  fileUrl        String
  category       String   @default("IMAGE") // IMAGE | DOCUMENT | FLOOR_PLAN
  createdAt      DateTime @default(now())

  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([organizationId])
  @@map("property_media")
}

model OrganizationSequence {
  id             String   @id @default(uuid())
  organizationId String
  key            String   // e.g. "PROPERTY"
  currentValue   Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_sequences")
}

model Amenity {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String?
  icon        String?
  createdAt   DateTime @default(now())

  properties  PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@map("property_amenities")
}

// ------------------------------------------------------------------------------
// PG STRUCTURE (Floors, Rooms, Beds)
// ------------------------------------------------------------------------------

model Floor {
  id          String    @id @default(uuid())
  propertyId  String
  floorNumber Int
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@unique([propertyId, floorNumber])
  @@index([propertyId])
  @@map("floors")
}

model Room {
  id          String          @id @default(uuid())
  propertyId  String
  floorId     String
  roomNumber  String
  sharingType RoomSharingType
  capacity    Int
  baseRent    Decimal         @db.Decimal(10, 2)
  amenities   String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  floor    Floor              @relation(fields: [floorId], references: [id], onDelete: Cascade)
  property Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  beds     Bed[]
  meters   Meter[]
  maintenanceTickets MaintenanceTicket[]
  inventoryItems InventoryItem[]

  @@unique([floorId, roomNumber])
  @@index([propertyId])
  @@index([floorId])
  @@map("rooms")
}

model Bed {
  id          String    @id @default(uuid())
  roomId      String
  bedNumber   String
  monthlyRent Decimal   @db.Decimal(10, 2)
  status      BedStatus @default(AVAILABLE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  room  Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stays TenantStayHistory[]
  checkIns CheckIn[]
  checkouts Checkout[]

  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@index([status])
  @@map("beds")
}

// ------------------------------------------------------------------------------
// WHOLE-UNIT RENTAL STRUCTURE (Units, Leases, Escalations)
// ------------------------------------------------------------------------------

model RentalUnit {
  id                   String           @id @default(uuid())
  propertyId           String
  unitNumber           String
  unitType             String
  floorNumber          Int?
  superBuiltupAreaSqFt Float?
  carpetAreaSqFt       Float?
  furnishingStatus     String           @default("SEMI_FURNISHED")
  monthlyRent          Decimal          @db.Decimal(10, 2)
  securityDeposit      Decimal          @db.Decimal(10, 2)
  maintenanceCharges   Decimal          @default(0) @db.Decimal(10, 2)
  status               RentalUnitStatus @default(AVAILABLE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases   Lease[]
  meters   Meter[]
  maintenanceTickets MaintenanceTicket[]
  inventoryItems InventoryItem[]
  checkIns CheckIn[]
  checkouts Checkout[]

  @@unique([propertyId, unitNumber])
  @@index([status])
  @@map("rental_units")
}

model Lease {
  id               String      @id @default(uuid())
  rentalUnitId     String
  tenantId         String
  startDate        DateTime
  endDate          DateTime
  monthlyRent      Decimal     @db.Decimal(10, 2)
  securityDeposit  Decimal     @db.Decimal(10, 2)
  noticePeriodDays Int         @default(30)
  lockInMonths     Int         @default(6)
  status           LeaseStatus @default(ACTIVE)
  terms            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  rentalUnit  RentalUnit        @relation(fields: [rentalUnitId], references: [id], onDelete: Restrict)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  escalations RentEscalation[]
  agreement   Agreement?
  checkIn     CheckInRecord?
  checkOut    CheckOutRecord?
  checkIns    CheckIn[]
  checkouts   Checkout[]

  @@index([rentalUnitId])
  @@index([tenantId])
  @@index([status])
  @@map("leases")
}

model RentEscalation {
  id              String   @id @default(uuid())
  leaseId         String
  effectiveDate   DateTime
  percentage      Float
  escalatedAmount Decimal  @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now())

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@map("rent_escalations")
}

// ------------------------------------------------------------------------------
// TENANTS, KYC & STAY HISTORY
// ------------------------------------------------------------------------------

model Tenant {
  id                       String       @id @default(uuid())
  organizationId           String
  firstName                String
  lastName                 String
  email                    String?
  phone                    String
  dateOfBirth              DateTime?
  permanentAddress         String
  permanentCity            String
  permanentState           String
  permanentPostalCode      String
  occupation               String?
  employerOrCollege        String?
  emergencyContactName     String
  emergencyContactPhone    String
  emergencyContactRelation String
  status                   TenantStatus @default(PROSPECT)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  deletedAt                DateTime?

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents           TenantDocument[]
  stayHistories       TenantStayHistory[]
  leases              Lease[]
  invoices            Invoice[]
  payments            Payment[]
  securityDeposits    SecurityDeposit[]
  mealSubscriptions   MealSubscription[]
  maintenanceTickets  MaintenanceTicket[]
  visitors            VisitorRecord[]
  marketplaceListings MarketplaceListing[]
  communityPosts      CommunityPost[]
  notifications       Notification[]
  checkIns            CheckIn[]
  checkouts           Checkout[]
  settlements         Settlement[]

  @@index([organizationId])
  @@index([phone])
  @@index([status])
  @@map("tenants")
}

model TenantDocument {
  id                 String                @id @default(uuid())
  tenantId           String
  documentType       KycDocumentType
  documentNumber     String?
  storagePath        String
  originalFileName   String
  fileSize           Int
  mimeType           String
  verificationStatus KycVerificationStatus @default(PENDING)
  rejectionReason    String?
  verifiedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([verificationStatus])
  @@map("tenant_documents")
}

model TenantStayHistory {
  id          String    @id @default(uuid())
  tenantId    String
  bedId       String
  checkInDate DateTime
  checkOutDate DateTime?
  monthlyRent Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bed      Bed             @relation(fields: [bedId], references: [id], onDelete: Restrict)
  checkIn  CheckInRecord?
  checkOut CheckOutRecord?
  checkIns CheckIn[]
  checkouts Checkout[]

  @@index([tenantId])
  @@index([bedId])
  @@map("tenant_stay_histories")
}

// ------------------------------------------------------------------------------
// AGREEMENTS, CHECK-IN & CHECK-OUT
// ------------------------------------------------------------------------------

model AgreementTemplate {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  content        String
  propertyType   PropertyType
  version        Int      @default(1)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agreements   Agreement[]

  @@map("agreement_templates")
}

model Agreement {
  id           String          @id @default(uuid())
  templateId   String
  leaseId      String?         @unique
  title        String
  contentHtml  String
  status       AgreementStatus @default(DRAFT)
  signedAt     DateTime?
  documentUrl  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  template AgreementTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  lease    Lease?            @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@map("agreements")
}

model CheckIn {
  id                        String        @id @default(uuid())
  organizationId            String
  tenantId                  String
  propertyId                String
  bedId                     String?
  rentalUnitId              String?
  leaseId                   String?
  stayHistoryId             String?
  checkInDate               DateTime
  expectedCheckoutDate      DateTime?
  status                    CheckInStatus @default(INITIATED)
  emergencyContactConfirmed Boolean       @default(false)
  kycConfirmed              Boolean       @default(false)
  notes                     String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  completedAt               DateTime?
  cancelledAt               DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  bed          Bed?               @relation(fields: [bedId], references: [id], onDelete: SetNull)
  rentalUnit   RentalUnit?        @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  lease        Lease?             @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  stayHistory  TenantStayHistory? @relation(fields: [stayHistoryId], references: [id], onDelete: SetNull)
  checkouts    Checkout[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([bedId])
  @@index([rentalUnitId])
  @@index([leaseId])
  @@map("check_ins")
}

model Checkout {
  id             String         @id @default(uuid())
  organizationId String
  tenantId       String
  propertyId     String
  checkInId      String?
  stayHistoryId  String?
  leaseId        String?
  rentalUnitId   String?
  bedId          String?
  checkoutDate   DateTime
  status         CheckoutStatus @default(INITIATED)
  reason         String?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  checkIn      CheckIn?           @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  stayHistory  TenantStayHistory? @relation(fields: [stayHistoryId], references: [id], onDelete: SetNull)
  lease        Lease?             @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  rentalUnit   RentalUnit?        @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  bed          Bed?               @relation(fields: [bedId], references: [id], onDelete: SetNull)
  settlement   Settlement?

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([checkInId])
  @@index([leaseId])
  @@index([bedId])
  @@index([rentalUnitId])
  @@map("checkouts")
}

model Settlement {
  id                 String           @id @default(uuid())
  organizationId     String
  tenantId           String
  checkoutId         String           @unique
  securityDeposit    Decimal          @default(0) @db.Decimal(10, 2)
  outstandingRent    Decimal          @default(0) @db.Decimal(10, 2)
  maintenanceCharges Decimal          @default(0) @db.Decimal(10, 2)
  deductions         Decimal          @default(0) @db.Decimal(10, 2)
  refundableAmount   Decimal          @default(0) @db.Decimal(10, 2)
  amountDue          Decimal          @default(0) @db.Decimal(10, 2)
  amountRefundable   Decimal          @default(0) @db.Decimal(10, 2)
  status             SettlementStatus @default(DRAFT)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  checkout     Checkout     @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tenantId])
  @@index([status])
  @@map("settlements")
}

model CheckInRecord {
  id            String   @id @default(uuid())
  stayHistoryId String?  @unique
  leaseId       String?  @unique
  checkInDate   DateTime
  initialDeposit Decimal @db.Decimal(10, 2)
  initialRent    Decimal @db.Decimal(10, 2)
  verifiedKycs   Boolean @default(false)
  notes          String?
  createdAt      DateTime @default(now())

  stayHistory TenantStayHistory? @relation(fields: [stayHistoryId], references: [id], onDelete: SetNull)
  lease       Lease?             @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@map("check_in_records")
}

model CheckOutRecord {
  id               String   @id @default(uuid())
  stayHistoryId    String?  @unique
  leaseId          String?  @unique
  checkOutDate     DateTime
  noticeDate       DateTime?
  inspectionNotes  String?
  damageCharges    Decimal  @default(0) @db.Decimal(10, 2)
  unpaidDues       Decimal  @default(0) @db.Decimal(10, 2)
  depositRefunded  Decimal  @default(0) @db.Decimal(10, 2)
  settlementStatus String   @default("SETTLED")
  createdAt        DateTime @default(now())

  stayHistory TenantStayHistory? @relation(fields: [stayHistoryId], references: [id], onDelete: SetNull)
  lease       Lease?             @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@map("check_out_records")
}

// ------------------------------------------------------------------------------
// BILLING, PAYMENTS, DEPOSITS & LEDGER
// ------------------------------------------------------------------------------

model Invoice {
  id                 String        @id @default(uuid())
  organizationId     String
  propertyId         String
  tenantId           String
  invoiceNumber      String        @unique
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  subtotal           Decimal       @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(10, 2)
  lateFeeAmount      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal       @db.Decimal(10, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(10, 2)
  balanceDue         Decimal       @db.Decimal(10, 2)
  status             InvoiceStatus @default(ISSUED)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items         InvoiceItem[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  category    String   // RENT, ELECTRICITY, MEALS, MAINTENANCE, LATE_FEE, OTHER
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id                   String        @id @default(uuid())
  organizationId       String
  invoiceId            String
  tenantId             String
  paymentNumber        String        @unique
  amount               Decimal       @db.Decimal(10, 2)
  paymentMethod        PaymentMethod
  transactionReference String?
  status               PaymentStatus @default(COMPLETED)
  paymentDate          DateTime      @default(now())
  notes                String?
  createdAt            DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt      Receipt?
  ledgerEntry  LedgerEntry?

  @@index([organizationId])
  @@index([invoiceId])
  @@index([tenantId])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  receiptNumber String   @unique
  issuedAt      DateTime @default(now())
  pdfUrl        String?
  createdAt     DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model LedgerEntry {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String?
  paymentId      String?  @unique
  entryType      String   // DEBIT, CREDIT
  amount         Decimal  @db.Decimal(10, 2)
  balance        Decimal  @db.Decimal(10, 2)
  description    String
  createdAt      DateTime @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("ledger_entries")
}

model SecurityDeposit {
  id             String   @id @default(uuid())
  tenantId       String
  propertyId     String
  totalReceived  Decimal  @db.Decimal(10, 2)
  totalDeductions Decimal @default(0) @db.Decimal(10, 2)
  totalRefunded  Decimal  @default(0) @db.Decimal(10, 2)
  currentBalance Decimal  @db.Decimal(10, 2)
  status         String   @default("HELD") // HELD, PARTIALLY_REFUNDED, FULLY_REFUNDED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transactions DepositTransaction[]

  @@index([tenantId])
  @@map("security_deposits")
}

model DepositTransaction {
  id                String   @id @default(uuid())
  securityDepositId String
  transactionType   String   // RECEIVED, DEDUCTION, REFUND
  amount            Decimal  @db.Decimal(10, 2)
  reason            String?
  transactionDate   DateTime @default(now())
  createdAt         DateTime @default(now())

  securityDeposit SecurityDeposit @relation(fields: [securityDepositId], references: [id], onDelete: Cascade)

  @@map("deposit_transactions")
}

// ------------------------------------------------------------------------------
// ELECTRICITY & UTILITIES
// ------------------------------------------------------------------------------

model Meter {
  id           String    @id @default(uuid())
  propertyId   String
  roomId       String?
  rentalUnitId String?
  meterNumber  String
  initialReading Decimal @default(0) @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())

  property   Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rentalUnit RentalUnit?         @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  readings   MeterReading[]
  charges    ElectricityCharge[]

  @@unique([propertyId, meterNumber])
  @@map("meters")
}

model MeterReading {
  id              String   @id @default(uuid())
  meterId         String
  readingDate     DateTime
  previousReading Decimal  @db.Decimal(10, 2)
  currentReading  Decimal  @db.Decimal(10, 2)
  unitsConsumed   Decimal  @db.Decimal(10, 2)
  isResetOverride Boolean  @default(false)
  resetReason     String?
  recordedBy      String?
  createdAt       DateTime @default(now())

  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@index([meterId, readingDate])
  @@map("meter_readings")
}

model ElectricityRate {
  id             String   @id @default(uuid())
  propertyId     String
  ratePerUnitInr Decimal  @db.Decimal(10, 2)
  effectiveFrom  DateTime
  createdAt      DateTime @default(now())

  @@index([propertyId])
  @@map("electricity_rates")
}

model ElectricityCharge {
  id            String   @id @default(uuid())
  meterId       String
  readingId     String
  units         Decimal  @db.Decimal(10, 2)
  ratePerUnit   Decimal  @db.Decimal(10, 2)
  totalCharge   Decimal  @db.Decimal(10, 2)
  billingMonth  DateTime
  createdAt     DateTime @default(now())

  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@map("electricity_charges")
}

// ------------------------------------------------------------------------------
// FOOD & MEAL MANAGEMENT (PG Only)
// ------------------------------------------------------------------------------

model MealPlan {
  id          String   @id @default(uuid())
  propertyId  String
  name        String
  description String?
  pricePerDay Decimal  @db.Decimal(10, 2)
  hasBreakfast Boolean @default(true)
  hasLunch     Boolean @default(true)
  hasDinner    Boolean @default(true)
  createdAt   DateTime @default(now())

  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  subscriptions MealSubscription[]

  @@map("meal_plans")
}

model MealSubscription {
  id          String    @id @default(uuid())
  mealPlanId  String
  tenantId    String
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  mealPlan MealPlan          @relation(fields: [mealPlanId], references: [id], onDelete: Restrict)
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records  MealDailyRecord[]

  @@index([tenantId])
  @@map("meal_subscriptions")
}

model MealDailyRecord {
  id             String   @id @default(uuid())
  subscriptionId String
  date           DateTime
  breakfastTaken Boolean  @default(false)
  lunchTaken     Boolean  @default(false)
  dinnerTaken    Boolean  @default(false)
  createdAt      DateTime @default(now())

  subscription MealSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, date])
  @@map("meal_daily_records")
}

// ------------------------------------------------------------------------------
// MAINTENANCE TICKETING
// ------------------------------------------------------------------------------

model MaintenanceTicket {
  id             String              @id @default(uuid())
  propertyId     String
  roomId         String?
  rentalUnitId   String?
  tenantId       String?
  createdById    String
  assignedToId   String?
  ticketNumber   String              @unique
  title          String
  description    String
  category       MaintenanceCategory
  priority       MaintenancePriority @default(MEDIUM)
  status         MaintenanceStatus   @default(OPEN)
  estimatedCost  Decimal?            @db.Decimal(10, 2)
  actualCost     Decimal?            @db.Decimal(10, 2)
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  property   Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rentalUnit RentalUnit?          @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  tenant     Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy  User                 @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User?                @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments   MaintenanceComment[]

  @@index([propertyId])
  @@index([status])
  @@index([category])
  @@map("maintenance_tickets")
}

model MaintenanceComment {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  createdAt DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("maintenance_comments")
}

// ------------------------------------------------------------------------------
// STAFF & ATTENDANCE
// ------------------------------------------------------------------------------

model StaffMember {
  id             String   @id @default(uuid())
  organizationId String
  propertyId     String?
  userId         String?  @unique
  name           String
  roleTitle      String
  phone          String
  salaryMonthly  Decimal  @db.Decimal(10, 2)
  joinedDate     DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance   StaffAttendance[]

  @@index([organizationId])
  @@map("staff_members")
}

model StaffAttendance {
  id            String    @id @default(uuid())
  staffMemberId String
  date          DateTime
  checkInTime   DateTime
  checkOutTime  DateTime?
  status        String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE
  createdAt     DateTime  @default(now())

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, date])
  @@map("staff_attendance")
}

// ------------------------------------------------------------------------------
// VISITORS & GATEPASS
// ------------------------------------------------------------------------------

model VisitorRecord {
  id           String    @id @default(uuid())
  propertyId   String
  tenantId     String
  visitorName  String
  visitorPhone String
  purpose      String
  gatePassCode String    @unique
  entryTime    DateTime  @default(now())
  exitTime     DateTime?
  isApproved   Boolean   @default(true)
  createdAt    DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId, entryTime])
  @@map("visitor_records")
}

// ------------------------------------------------------------------------------
// INVENTORY
// ------------------------------------------------------------------------------

model InventoryItem {
  id            String   @id @default(uuid())
  propertyId    String
  roomId        String?
  rentalUnitId  String?
  itemName      String
  category      String   // APPLIANCE, FURNITURE, LINEN, ELECTRONIC
  serialNumber  String?
  condition     String   @default("GOOD") // NEW, GOOD, FAIR, DAMAGED
  status        String   @default("AVAILABLE") // AVAILABLE, ASSIGNED, UNDER_REPAIR, DISPOSED
  purchaseDate  DateTime?
  purchasePrice Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rentalUnit RentalUnit? @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@map("inventory_items")
}

// ------------------------------------------------------------------------------
// EXPENSES & FINANCIALS
// ------------------------------------------------------------------------------

model ExpenseCategory {
  id          String              @id @default(uuid())
  name        ExpenseCategoryType @unique
  description String?

  expenses ExpenseRecord[]

  @@map("expense_categories")
}

model ExpenseRecord {
  id             String   @id @default(uuid())
  organizationId String
  propertyId     String
  categoryId     String
  title          String
  amount         Decimal  @db.Decimal(10, 2)
  expenseDate    DateTime
  vendorName     String?
  receiptUrl     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([organizationId, expenseDate])
  @@index([propertyId, expenseDate])
  @@map("expense_records")
}

// ------------------------------------------------------------------------------
// NOTIFICATIONS & COMMUNITY & MARKETPLACE
// ------------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isRead])
  @@map("notifications")
}

model CommunityPost {
  id         String   @id @default(uuid())
  propertyId String
  tenantId   String
  title      String
  content    String
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comments CommunityComment[]

  @@index([propertyId])
  @@map("community_posts")
}

model CommunityComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("community_comments")
}

model MarketplaceListing {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String
  price       Decimal  @db.Decimal(10, 2)
  category    String   // FURNITURE, ELECTRONICS, BOOKS, APPLIANCES, OTHER
  images      String[] @default([])
  status      String   @default("ACTIVE") // ACTIVE, SOLD, EXPIRED, REMOVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("marketplace_listings")
}

model ServiceRequest {
  id           String   @id @default(uuid())
  propertyId   String
  serviceType  String   // PLUMBING, ELECTRICAL, PAINTING, CLEANING, CARPENTRY, AC_SERVICE, OTHER
  title        String
  description  String
  status       String   @default("PENDING") // PENDING, SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  contactPhone String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("service_requests")
}
