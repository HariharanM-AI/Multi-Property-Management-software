// ------------------------------------------------------------------------------
// MULTI-TENANCY & IDENTITY
// ------------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid())
  name        String
  legalName   String?
  taxIdGst    String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users                   User[]
  properties              Property[]
  tenants                 Tenant[]
  invoices                Invoice[]
  payments                Payment[]
  expenses                ExpenseRecord[]
  auditLogs               AuditLog[]
  staffMembers            StaffMember[]
  agreementTemplates      AgreementTemplate[]
  teamInvitations         TeamInvitation[]
  sequences               OrganizationSequence[]
  propertyMedia           PropertyMedia[]
  checkIns                CheckIn[]
  checkouts               Checkout[]
  settlements             Settlement[]
  agreements              Agreement[]
  billingCharges          BillingCharge[]
  billingSchedules        BillingSchedule[]
  credits                 Credit[]
  securityDepositAccounts SecurityDepositAccount[]
  ledgerEntries           LedgerEntry[]
  electricityMeters       ElectricityMeter[]
  electricityReadings     ElectricityReading[]
  electricityRates        ElectricityRate[]
  electricityCharges      ElectricityCharge[]
  mealPlans               MealPlan[]
  mealSubscriptions       MealSubscription[]
  mealRecords             MealRecord[]
  mealCharges             MealCharge[]
  maintenanceTickets      MaintenanceTicket[]
  maintenanceVendors      MaintenanceVendor[]
  maintenanceComments     MaintenanceComment[]
  maintenanceAttachments  MaintenanceAttachment[]
  maintenanceStatusHistories MaintenanceStatusHistory[]
  maintenanceAssignments  MaintenanceAssignment[]
  notifications           Notification[]
  communityPosts          CommunityPost[]
  communityComments       CommunityComment[]
  marketplaceListings     MarketplaceListing[]
  serviceRequests         ServiceRequest[]

  @@map("organizations")
}

model User {
  id             String    @id @default(uuid())
  organizationId String
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  sessions       Session[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations TeamInvitation[] @relation("SentInvitations")
  auditLogs      AuditLog[]
  staffProfile   StaffMember?
  createdTickets MaintenanceTicket[] @relation("TicketCreator")
  assignedTickets MaintenanceTicket[] @relation("TicketAssignee")
  maintenanceComments MaintenanceComment[]
  maintenanceAttachments MaintenanceAttachment[]
  maintenanceAssignmentsReceived MaintenanceAssignment[] @relation("StaffAssignedTo")
  maintenanceAssignmentsCreated  MaintenanceAssignment[] @relation("StaffAssignedBy")
  maintenanceStatusChanges MaintenanceStatusHistory[]
  notifications            Notification[]
  communityPosts          CommunityPost[]
  communityComments       CommunityComment[]
  marketplaceListings     MarketplaceListing[]
  serviceRequests         ServiceRequest[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        UserRoleType @unique
  description String?
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model TeamInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           UserRoleType
  tokenHash      String           @unique
  invitedById    String
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([status])
  @@map("team_invitations")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String
  resourceId     String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, resourceType])
  @@index([organizationId, userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// PROPERTY MANAGEMENT
// ------------------------------------------------------------------------------

model Property {
  id             String         @id @default(uuid())
  organizationId String
  code           String         // e.g. PROP-000001
  name           String
  propertyType   PropertyType   // PG | RENTAL_HOUSE (immutable)
  status         PropertyStatus @default(ACTIVE)
  description    String?
  address        String
  addressLine1   String?
  addressLine2   String?
  locality       String?
  city           String
  district       String?
  state          String
  country        String         @default("India")
  postalCode     String         // 6-digit Indian PIN code
  latitude       Float?
  longitude      Float?
  contactPhone   String?
  contactEmail   String?
  images         String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amenities      PropertyAmenity[]
  media          PropertyMedia[]
  floors         Floor[]
  rooms          Room[]
  rentalUnits    RentalUnit[]
  electricityMeters       ElectricityMeter[]
  electricityReadings     ElectricityReading[]
  electricityRates        ElectricityRate[]
  electricityCharges      ElectricityCharge[]
  mealPlans               MealPlan[]
  mealSubscriptions       MealSubscription[]
  mealRecords             MealRecord[]
  mealCharges             MealCharge[]
  maintenanceTickets MaintenanceTicket[]
  staffMembers   StaffMember[]
  visitors       VisitorRecord[]
  inventoryItems InventoryItem[]
  expenses       ExpenseRecord[]
  invoices       Invoice[]
  communityPosts CommunityPost[]
  serviceRequests ServiceRequest[]
  checkIns         CheckIn[]
  checkouts        Checkout[]
  agreements       Agreement[]
  billingSchedules BillingSchedule[]
  notifications    Notification[]
  marketplaceListings MarketplaceListing[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, propertyType])
  @@index([organizationId, city])
  @@index([city, propertyType])
  @@index([status])
  @@index([status, city, propertyType])
  @@index([locality])
  @@map("properties")
}

model PropertyMedia {
  id             String   @id @default(uuid())
  propertyId     String
  organizationId String
  fileName       String
  originalName   String
  mimeType       String
  fileSize       Int
  fileUrl        String
  category       String   @default("IMAGE") // IMAGE | DOCUMENT | FLOOR_PLAN
  createdAt      DateTime @default(now())

  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([organizationId])
  @@map("property_media")
}

model OrganizationSequence {
  id             String   @id @default(uuid())
  organizationId String
  key            String   // e.g. "PROPERTY"
  currentValue   Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_sequences")
}

model Amenity {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String?
  icon        String?
  createdAt   DateTime @default(now())

  properties  PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@map("property_amenities")
}

// ------------------------------------------------------------------------------
// PG STRUCTURE (Floors, Rooms, Beds)
// ------------------------------------------------------------------------------

model Floor {
  id          String    @id @default(uuid())
  propertyId  String
  floorNumber Int
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms    Room[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([propertyId, floorNumber])
  @@index([propertyId])
  @@map("floors")
}

model Room {
  id          String          @id @default(uuid())
  propertyId  String
  floorId     String
  roomNumber  String
  sharingType RoomSharingType
  capacity    Int
  baseRent    Decimal         @db.Decimal(10, 2)
  amenities   String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  floor    Floor              @relation(fields: [floorId], references: [id], onDelete: Cascade)
  property Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  beds     Bed[]
  electricityMeters   ElectricityMeter[]
  electricityCharges  ElectricityCharge[]
  maintenanceTickets MaintenanceTicket[]
  inventoryItems InventoryItem[]
  serviceRequests ServiceRequest[]

  @@unique([floorId, roomNumber])
  @@index([propertyId])
  @@index([floorId])
  @@map("rooms")
}

model Bed {
  id          String    @id @default(uuid())
  roomId      String
  bedNumber   String
  monthlyRent Decimal   @db.Decimal(10, 2)
  status      BedStatus @default(AVAILABLE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  room  Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stays TenantStayHistory[]
  checkIns CheckIn[]
  checkouts Checkout[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@index([status])
  @@map("beds")
}

// ------------------------------------------------------------------------------
// WHOLE-UNIT RENTAL STRUCTURE (Units, Leases, Escalations)
// ------------------------------------------------------------------------------

model RentalUnit {
  id                   String           @id @default(uuid())
  propertyId           String
  unitNumber           String
  unitType             String
  floorNumber          Int?
  superBuiltupAreaSqFt Float?
  carpetAreaSqFt       Float?
  furnishingStatus     String           @default("SEMI_FURNISHED")
  monthlyRent          Decimal          @db.Decimal(10, 2)
  securityDeposit      Decimal          @db.Decimal(10, 2)
  maintenanceCharges   Decimal          @default(0) @db.Decimal(10, 2)
  status               RentalUnitStatus @default(AVAILABLE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases   Lease[]
  electricityMeters ElectricityMeter[]
  maintenanceTickets MaintenanceTicket[]
  inventoryItems InventoryItem[]
  checkIns CheckIn[]
  checkouts Checkout[]
  serviceRequests ServiceRequest[]

  @@unique([propertyId, unitNumber])
  @@index([status])
  @@map("rental_units")
}

model Lease {
  id               String      @id @default(uuid())
  rentalUnitId     String
  tenantId         String
  startDate        DateTime
  endDate          DateTime
  monthlyRent      Decimal     @db.Decimal(10, 2)
  securityDeposit  Decimal     @db.Decimal(10, 2)
  noticePeriodDays Int         @default(30)
  lockInMonths     Int         @default(6)
  status           LeaseStatus @default(ACTIVE)
  terms            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  rentalUnit  RentalUnit        @relation(fields: [rentalUnitId], references: [id], onDelete: Restrict)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  escalations RentEscalation[]
  agreements  Agreement[]
  checkIn     CheckInRecord?
  checkOut    CheckOutRecord?
  checkIns                CheckIn[]
  checkouts               Checkout[]
  billingSchedules        BillingSchedule[]
  invoices                Invoice[]
  securityDepositAccounts SecurityDepositAccount[]

  @@index([rentalUnitId])
  @@index([tenantId])
  @@index([status])
  @@map("leases")
}

model RentEscalation {
  id              String   @id @default(uuid())
  leaseId         String
  effectiveDate   DateTime
  percentage      Float
  escalatedAmount Decimal  @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now())

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@map("rent_escalations")
}

// ------------------------------------------------------------------------------
// TENANTS, KYC & STAY HISTORY
// ------------------------------------------------------------------------------

model Tenant {
  id                       String       @id @default(uuid())
  organizationId           String
  firstName                String
  lastName                 String
  email                    String?
  phone                    String
  dateOfBirth              DateTime?
  permanentAddress         String
  permanentCity            String
  permanentState           String
  permanentPostalCode      String
  occupation               String?
  employerOrCollege        String?
  emergencyContactName     String
  emergencyContactPhone    String
  emergencyContactRelation String
  status                   TenantStatus @default(PROSPECT)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  deletedAt                DateTime?

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents           TenantDocument[]
  stayHistories       TenantStayHistory[]
  leases              Lease[]
  invoices                Invoice[]
  payments                Payment[]
  electricityCharges      ElectricityCharge[]
  mealSubscriptions       MealSubscription[]
  mealRecords             MealRecord[]
  mealCharges             MealCharge[]
  maintenanceTickets      MaintenanceTicket[]
  visitors                VisitorRecord[]
  marketplaceListings     MarketplaceListing[]
  communityPosts          CommunityPost[]
  communityComments       CommunityComment[]
  checkIns                CheckIn[]
  checkouts               Checkout[]
  settlements             Settlement[]
  serviceRequests         ServiceRequest[]
  agreements              Agreement[]
  billingSchedules        BillingSchedule[]
  credits                 Credit[]
  securityDepositAccounts SecurityDepositAccount[]
  ledgerEntries           LedgerEntry[]

  @@index([organizationId])
  @@index([phone])
  @@index([status])
  @@map("tenants")
}

model TenantDocument {
  id                 String                @id @default(uuid())
  tenantId           String
  documentType       KycDocumentType
  documentNumber     String?
  storagePath        String
  originalFileName   String
  fileSize           Int
  mimeType           String
  verificationStatus KycVerificationStatus @default(PENDING)
  rejectionReason    String?
  verifiedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([verificationStatus])
  @@map("tenant_documents")
}

model TenantStayHistory {
  id          String    @id @default(uuid())
  tenantId    String
  bedId       String
  checkInDate DateTime
  checkOutDate DateTime?
  monthlyRent Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bed      Bed             @relation(fields: [bedId], references: [id], onDelete: Restrict)
  checkIn  CheckInRecord?
  checkOut CheckOutRecord?
  checkIns CheckIn[]
  checkouts Checkout[]

  @@index([tenantId])
  @@index([bedId])
  @@map("tenant_stay_histories")
}

// ------------------------------------------------------------------------------
// AGREEMENTS, CHECK-IN & CHECK-OUT
// ------------------------------------------------------------------------------

model AgreementTemplate {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  agreementType  AgreementType
  description    String?
  content        String
  version        Int            @default(1)
  status         TemplateStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agreements   Agreement[]

  @@index([organizationId])
  @@index([status])
  @@index([agreementType])
  @@map("agreement_templates")
}

model Agreement {
  id                  String          @id @default(uuid())
  organizationId      String
  tenantId            String
  propertyId          String
  templateId          String?
  leaseId             String?
  checkInId           String?
  agreementType       AgreementType
  status              AgreementStatus @default(DRAFT)
  version             Int             @default(1)
  previousAgreementId String?
  templateVersion     Int?
  renderedContent     String
  documentPath        String?
  contentHash         String?
  generatedAt         DateTime?
  signedAt            DateTime?
  finalizedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property          Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  template          AgreementTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  lease             Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  checkIn           CheckIn?            @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  previousAgreement Agreement?          @relation("AgreementVersionLineage", fields: [previousAgreementId], references: [id], onDelete: SetNull)
  nextVersions      Agreement[]         @relation("AgreementVersionLineage")
  signatures        AgreementSignature[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([leaseId])
  @@index([checkInId])
  @@index([templateId])
  @@index([previousAgreementId])
  @@map("agreements")
}

model AgreementSignature {
  id            String              @id @default(uuid())
  agreementId   String
  signerType    AgreementSignerType
  signerName    String
  signerEmail   String?
  status        SignatureStatus     @default(PENDING)
  signedAt      DateTime?
  signatureData String?
  ipAddress     String?
  userAgent     String?
  contentHash   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@index([status])
  @@map("agreement_signatures")
}

model CheckIn {
  id                        String        @id @default(uuid())
  organizationId            String
  tenantId                  String
  propertyId                String
  bedId                     String?
  rentalUnitId              String?
  leaseId                   String?
  stayHistoryId             String?
  checkInDate               DateTime
  expectedCheckoutDate      DateTime?
  status                    CheckInStatus @default(INITIATED)
  emergencyContactConfirmed Boolean       @default(false)
  kycConfirmed              Boolean       @default(false)
  notes                     String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  completedAt               DateTime?
  cancelledAt               DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  bed          Bed?               @relation(fields: [bedId], references: [id], onDelete: SetNull)
  rentalUnit   RentalUnit?        @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  lease                   Lease?             @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  stayHistory             TenantStayHistory? @relation(fields: [stayHistoryId], references: [id], onDelete: SetNull)
  checkouts               Checkout[]
  agreements              Agreement[]
  billingSchedules        BillingSchedule[]
  invoices                Invoice[]
  securityDepositAccounts SecurityDepositAccount[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([bedId])
  @@index([rentalUnitId])
  @@index([leaseId])
  @@map("check_ins")
}

model Checkout {
  id             String         @id @default(uuid())
  organizationId String
  tenantId       String
  propertyId     String
  checkInId      String?
  stayHistoryId  String?
  leaseId        String?
  rentalUnitId   String?
  bedId          String?
  checkoutDate   DateTime
  status         CheckoutStatus @default(INITIATED)
  reason         String?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  checkIn      CheckIn?           @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  stayHistory  TenantStayHistory? @relation(fields: [stayHistoryId], references: [id], onDelete: SetNull)
  lease        Lease?             @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  rentalUnit   RentalUnit?        @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  bed          Bed?               @relation(fields: [bedId], references: [id], onDelete: SetNull)
  settlement   Settlement?

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([checkInId])
  @@index([leaseId])
  @@index([bedId])
  @@index([rentalUnitId])
  @@map("checkouts")
}

model Settlement {
  id                 String           @id @default(uuid())
  organizationId     String
  tenantId           String
  checkoutId         String           @unique
  securityDeposit    Decimal          @default(0) @db.Decimal(10, 2)
  outstandingRent    Decimal          @default(0) @db.Decimal(10, 2)
  maintenanceCharges Decimal          @default(0) @db.Decimal(10, 2)
  deductions         Decimal          @default(0) @db.Decimal(10, 2)
  refundableAmount   Decimal          @default(0) @db.Decimal(10, 2)
  amountDue          Decimal          @default(0) @db.Decimal(10, 2)
  amountRefundable   Decimal          @default(0) @db.Decimal(10, 2)
  status             SettlementStatus @default(DRAFT)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  checkout     Checkout     @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tenantId])
  @@index([status])
  @@map("settlements")
}

model CheckInRecord {
  id            String   @id @default(uuid())
  stayHistoryId String?  @unique
  leaseId       String?  @unique
  checkInDate   DateTime
  initialDeposit Decimal @db.Decimal(10, 2)
  initialRent    Decimal @db.Decimal(10, 2)
  verifiedKycs   Boolean @default(false)
  notes          String?
  createdAt      DateTime @default(now())

  stayHistory TenantStayHistory? @relation(fields: [stayHistoryId], references: [id], onDelete: SetNull)
  lease       Lease?             @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@map("check_in_records")
}

model CheckOutRecord {
  id               String   @id @default(uuid())
  stayHistoryId    String?  @unique
  leaseId          String?  @unique
  checkOutDate     DateTime
  noticeDate       DateTime?
  inspectionNotes  String?
  damageCharges    Decimal  @default(0) @db.Decimal(10, 2)
  unpaidDues       Decimal  @default(0) @db.Decimal(10, 2)
  depositRefunded  Decimal  @default(0) @db.Decimal(10, 2)
  settlementStatus String   @default("SETTLED")
  createdAt        DateTime @default(now())

  stayHistory TenantStayHistory? @relation(fields: [stayHistoryId], references: [id], onDelete: SetNull)
  lease       Lease?             @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@map("check_out_records")
}

// ------------------------------------------------------------------------------
// BILLING, INVOICING, PAYMENTS, SECURITY DEPOSITS & LEDGER (CORE-011)
// ------------------------------------------------------------------------------

model BillingCharge {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  chargeType     ChargeType
  description    String?
  amount         Decimal          @db.Decimal(12, 2)
  frequency      BillingFrequency
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceLines InvoiceLine[]
  schedules    BillingSchedule[]

  @@index([organizationId])
  @@index([chargeType])
  @@index([isActive])
  @@map("billing_charges")
}

model BillingSchedule {
  id              String           @id @default(uuid())
  organizationId  String
  tenantId        String
  propertyId      String?
  leaseId         String?
  checkInId       String?
  chargeId        String
  startDate       DateTime
  endDate         DateTime?
  frequency       BillingFrequency
  amount          Decimal          @db.Decimal(12, 2)
  nextBillingDate DateTime?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  lease        Lease?        @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  checkIn      CheckIn?      @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  charge       BillingCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([leaseId])
  @@index([nextBillingDate])
  @@index([active])
  @@map("billing_schedules")
}

model Invoice {
  id                String        @id @default(uuid())
  organizationId    String
  tenantId          String
  propertyId        String?
  leaseId           String?
  checkInId         String?
  invoiceNumber     String
  issueDate         DateTime
  dueDate           DateTime
  subtotal          Decimal       @db.Decimal(12, 2)
  adjustments       Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal       @default(0) @db.Decimal(12, 2)
  status            InvoiceStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property      Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  lease         Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  checkIn       CheckIn?            @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  allocations   PaymentAllocation[]
  ledgerEntries      LedgerEntry[]
  credits            Credit[]
  electricityCharges ElectricityCharge[]
  mealCharges        MealCharge[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String         @id @default(uuid())
  invoiceId   String
  chargeId    String?
  description String
  chargeType  ChargeType
  quantity    Decimal        @default(1) @db.Decimal(12, 2)
  unitAmount  Decimal        @db.Decimal(12, 2)
  totalAmount Decimal        @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())

  invoice Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  charge  BillingCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([chargeId])
  @@map("invoice_lines")
}

model Payment {
  id              String        @id @default(uuid())
  organizationId  String
  tenantId        String
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  paymentDate     DateTime
  status          PaymentStatus @default(RECORDED)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  allocations   PaymentAllocation[]
  ledgerEntries LedgerEntry[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}

model PaymentAllocation {
  id        String                  @id @default(uuid())
  paymentId String
  invoiceId String
  amount    Decimal                 @db.Decimal(12, 2)
  status    PaymentAllocationStatus @default(ACTIVE)
  createdAt DateTime                @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
  @@index([status])
  @@map("payment_allocations")
}

model Credit {
  id              String   @id @default(uuid())
  organizationId  String
  tenantId        String
  amount          Decimal  @db.Decimal(12, 2)
  remainingAmount Decimal  @db.Decimal(12, 2)
  reason          String
  sourceInvoiceId String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceInvoice Invoice?     @relation(fields: [sourceInvoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([tenantId])
  @@index([status])
  @@map("credits")
}

model SecurityDepositAccount {
  id             String   @id @default(uuid())
  organizationId String
  tenantId       String
  leaseId        String?
  checkInId      String?
  amountHeld     Decimal  @default(0) @db.Decimal(12, 2)
  amountRefunded Decimal  @default(0) @db.Decimal(12, 2)
  amountDeducted Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease        Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  checkIn      CheckIn?     @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([tenantId])
  @@index([leaseId])
  @@index([checkInId])
  @@map("security_deposit_accounts")
}

model LedgerEntry {
  id             String            @id @default(uuid())
  organizationId String
  tenantId       String
  invoiceId      String?
  paymentId      String?
  entryType      LedgerEntryType
  accountType    LedgerAccountType
  debitAmount    Decimal           @default(0) @db.Decimal(12, 2)
  creditAmount   Decimal           @default(0) @db.Decimal(12, 2)
  reference      String?
  description    String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([entryType])
  @@index([accountType])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ------------------------------------------------------------------------------
// ELECTRICITY & UTILITIES (PG & Configurable Properties)
// ------------------------------------------------------------------------------

model ElectricityMeter {
  id             String      @id @default(uuid())
  organizationId String
  propertyId     String
  roomId         String?
  rentalUnitId   String?
  meterNumber    String
  meterType      MeterType   @default(ROOM)
  status         MeterStatus @default(ACTIVE)
  initialReading Decimal     @default(0) @db.Decimal(12, 2)
  installedAt    DateTime    @default(now())
  lastReadingAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room         Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rentalUnit   RentalUnit?          @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  readings     ElectricityReading[]
  charges      ElectricityCharge[]

  @@unique([propertyId, meterNumber])
  @@index([organizationId])
  @@index([propertyId])
  @@index([roomId])
  @@index([meterType])
  @@index([status])
  @@map("electricity_meters")
}

model ElectricityReading {
  id                String   @id @default(uuid())
  organizationId    String
  propertyId        String
  meterId           String
  readingDate       DateTime
  previousReading   Decimal  @db.Decimal(12, 2)
  currentReading    Decimal  @db.Decimal(12, 2)
  unitsConsumed     Decimal  @db.Decimal(12, 2)
  previousReadingId String?
  isResetOverride   Boolean  @default(false)
  resetReason       String?
  recordedBy        String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  meter        ElectricityMeter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  charges      ElectricityCharge[]

  @@unique([meterId, readingDate])
  @@index([organizationId])
  @@index([propertyId])
  @@index([meterId])
  @@index([readingDate])
  @@map("electricity_readings")
}

model ElectricityRate {
  id             String                @id @default(uuid())
  organizationId String
  propertyId     String
  ratePerUnit    Decimal               @db.Decimal(12, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  status         ElectricityRateStatus @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId])
  @@index([effectiveFrom])
  @@index([status])
  @@map("electricity_rates")
}

model ElectricityCharge {
  id                String                    @id @default(uuid())
  organizationId    String
  propertyId        String
  meterId           String?
  readingId         String
  tenantId          String?
  roomId            String?
  chargePeriodStart DateTime
  chargePeriodEnd   DateTime
  unitsConsumed     Decimal                   @db.Decimal(12, 2)
  ratePerUnit       Decimal                   @db.Decimal(12, 2)
  amount            Decimal                   @db.Decimal(12, 2)
  allocationType    ElectricityAllocationType @default(ROOM_SHARED)
  status            ElectricityChargeStatus   @default(PENDING)
  invoiceId         String?
  invoiceLineId     String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  meter        ElectricityMeter?  @relation(fields: [meterId], references: [id], onDelete: SetNull)
  reading      ElectricityReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  room         Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
  @@index([meterId])
  @@index([readingId])
  @@index([tenantId])
  @@index([roomId])
  @@index([status])
  @@map("electricity_charges")
}

// ------------------------------------------------------------------------------
// FOOD & MEAL MANAGEMENT (PG Only)
// ------------------------------------------------------------------------------

model MealPlan {
  id               String           @id @default(uuid())
  organizationId   String
  propertyId       String
  name             String
  description      String?
  price            Decimal          @db.Decimal(12, 2)
  billingFrequency BillingFrequency @default(MONTHLY)
  status           MealPlanStatus   @default(ACTIVE)
  hasBreakfast     Boolean          @default(true)
  hasLunch         Boolean          @default(true)
  hasDinner        Boolean          @default(true)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  subscriptions MealSubscription[]
  charges       MealCharge[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@map("meal_plans")
}

model MealSubscription {
  id             String                 @id @default(uuid())
  organizationId String
  propertyId     String
  tenantId       String
  mealPlanId     String
  startDate      DateTime
  endDate        DateTime?
  status         MealSubscriptionStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mealPlan     MealPlan     @relation(fields: [mealPlanId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([mealPlanId])
  @@index([status])
  @@map("meal_subscriptions")
}

model MealRecord {
  id             String           @id @default(uuid())
  organizationId String
  propertyId     String
  tenantId       String
  mealDate       DateTime
  mealType       MealType
  status         MealRecordStatus @default(CONSUMED)
  recordedAt     DateTime         @default(now())
  recordedBy     String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  charges      MealCharge[]

  @@unique([tenantId, mealDate, mealType])
  @@index([organizationId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([mealDate])
  @@index([status])
  @@map("meal_records")
}

model MealCharge {
  id             String           @id @default(uuid())
  organizationId String
  propertyId     String
  tenantId       String
  mealPlanId     String?
  mealRecordId   String?
  periodStart    DateTime
  periodEnd      DateTime
  billingMode    MealBillingMode  @default(SUBSCRIPTION)
  amount         Decimal          @db.Decimal(12, 2)
  status         MealChargeStatus @default(PENDING)
  invoiceId      String?
  invoiceLineId  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mealPlan     MealPlan?    @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  mealRecord   MealRecord?  @relation(fields: [mealRecordId], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@map("meal_charges")
}

// ------------------------------------------------------------------------------
// MAINTENANCE TICKETING & WORK ORDERS (CORE-013)
// ------------------------------------------------------------------------------

model MaintenanceTicket {
  id                String                 @id @default(uuid())
  organizationId    String
  propertyId        String
  floorId           String?
  roomId            String?
  bedId             String?
  rentalUnitId      String?
  tenantId          String?
  createdById       String
  assignedToId      String?
  vendorId          String?
  ticketNumber      String                 @unique
  title             String
  description       String
  category          MaintenanceCategory
  priority          MaintenancePriority    @default(MEDIUM)
  status            MaintenanceStatus      @default(OPEN)
  targetType        MaintenanceTargetType  @default(PROPERTY)
  locationDetails   String?
  estimatedCost     Decimal?               @db.Decimal(12, 2)
  actualCost        Decimal?               @db.Decimal(12, 2)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  closedAt          DateTime?
  cancelledAt       DateTime?
  resolutionNotes   String?
  tenantConfirmedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property      Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floor         Floor?                     @relation(fields: [floorId], references: [id], onDelete: SetNull)
  room          Room?                      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bed           Bed?                       @relation(fields: [bedId], references: [id], onDelete: SetNull)
  rentalUnit    RentalUnit?                @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  tenant        Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy     User                       @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo    User?                      @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  vendor        MaintenanceVendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  comments      MaintenanceComment[]
  attachments   MaintenanceAttachment[]
  assignments   MaintenanceAssignment[]
  statusHistory MaintenanceStatusHistory[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([assignedToId])
  @@index([vendorId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@index([scheduledAt])
  @@map("maintenance_tickets")
}

model MaintenanceComment {
  id             String   @id @default(uuid())
  organizationId String
  ticketId       String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ticketId])
  @@index([authorId])
  @@map("maintenance_comments")
}

model MaintenanceAttachment {
  id             String                    @id @default(uuid())
  organizationId String
  ticketId       String
  uploadedById   String
  type           MaintenanceAttachmentType @default(OTHER)
  fileName       String
  storagePath    String
  mimeType       String
  fileSize       Int
  createdAt      DateTime                  @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ticketId])
  @@index([uploadedById])
  @@map("maintenance_attachments")
}

model MaintenanceAssignment {
  id             String    @id @default(uuid())
  organizationId String
  ticketId       String
  assignedToId   String
  assignedById   String
  notes          String?
  assignedAt     DateTime  @default(now())
  unassignedAt   DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedTo   User              @relation("StaffAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy   User              @relation("StaffAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ticketId])
  @@index([assignedToId])
  @@map("maintenance_assignments")
}

model MaintenanceStatusHistory {
  id             String            @id @default(uuid())
  organizationId String
  ticketId       String
  fromStatus     MaintenanceStatus
  toStatus       MaintenanceStatus
  changedById    String
  reason         String?
  createdAt      DateTime          @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy    User              @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([ticketId])
  @@index([createdAt])
  @@map("maintenance_status_history")
}

model MaintenanceVendor {
  id             String                  @id @default(uuid())
  organizationId String
  name           String
  phone          String
  email          String?
  category       MaintenanceCategory?
  address        String?
  notes          String?
  status         MaintenanceVendorStatus @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      MaintenanceTicket[]

  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@map("maintenance_vendors")
}

// ------------------------------------------------------------------------------
// STAFF & ATTENDANCE
// ------------------------------------------------------------------------------

model StaffMember {
  id             String   @id @default(uuid())
  organizationId String
  propertyId     String?
  userId         String?  @unique
  name           String
  roleTitle      String
  phone          String
  salaryMonthly  Decimal  @db.Decimal(10, 2)
  joinedDate     DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance   StaffAttendance[]
  serviceRequests ServiceRequest[]

  @@index([organizationId])
  @@map("staff_members")
}

model StaffAttendance {
  id            String    @id @default(uuid())
  staffMemberId String
  date          DateTime
  checkInTime   DateTime
  checkOutTime  DateTime?
  status        String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE
  createdAt     DateTime  @default(now())

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, date])
  @@map("staff_attendance")
}

// ------------------------------------------------------------------------------
// VISITORS & GATEPASS
// ------------------------------------------------------------------------------

model VisitorRecord {
  id           String    @id @default(uuid())
  propertyId   String
  tenantId     String
  visitorName  String
  visitorPhone String
  purpose      String
  gatePassCode String    @unique
  entryTime    DateTime  @default(now())
  exitTime     DateTime?
  isApproved   Boolean   @default(true)
  createdAt    DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId, entryTime])
  @@map("visitor_records")
}

// ------------------------------------------------------------------------------
// INVENTORY
// ------------------------------------------------------------------------------

model InventoryItem {
  id            String   @id @default(uuid())
  propertyId    String
  roomId        String?
  rentalUnitId  String?
  itemName      String
  category      String   // APPLIANCE, FURNITURE, LINEN, ELECTRONIC
  serialNumber  String?
  condition     String   @default("GOOD") // NEW, GOOD, FAIR, DAMAGED
  status        String   @default("AVAILABLE") // AVAILABLE, ASSIGNED, UNDER_REPAIR, DISPOSED
  purchaseDate  DateTime?
  purchasePrice Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rentalUnit RentalUnit? @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@map("inventory_items")
}

// ------------------------------------------------------------------------------
// EXPENSES & FINANCIALS
// ------------------------------------------------------------------------------

model ExpenseCategory {
  id          String              @id @default(uuid())
  name        ExpenseCategoryType @unique
  description String?

  expenses ExpenseRecord[]

  @@map("expense_categories")
}

model ExpenseRecord {
  id             String   @id @default(uuid())
  organizationId String
  propertyId     String
  categoryId     String
  title          String
  amount         Decimal  @db.Decimal(10, 2)
  expenseDate    DateTime
  vendorName     String?
  receiptUrl     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([organizationId, expenseDate])
  @@index([propertyId, expenseDate])
  @@map("expense_records")
}

// ------------------------------------------------------------------------------
// NOTIFICATIONS & COMMUNITY & MARKETPLACE
// ------------------------------------------------------------------------------

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  propertyId     String?
  type           NotificationType
  title          String           @db.VarChar(255)
  message        String           @db.Text
  link           String?          @db.VarChar(500)
  metadata       Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model CommunityPost {
  id             String                @id @default(uuid())
  organizationId String
  propertyId     String
  authorId       String
  authorName     String
  authorRole     UserRoleType
  tenantId       String?
  title          String                @db.VarChar(255)
  content        String                @db.Text
  category       CommunityPostCategory @default(GENERAL)
  isPinned       Boolean               @default(false)
  isOfficial     Boolean               @default(false)
  status         CommunityPostStatus   @default(ACTIVE)
  images         String[]              @default([])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  comments     CommunityComment[]

  @@index([organizationId, propertyId, isPinned, createdAt])
  @@index([propertyId, createdAt])
  @@map("community_posts")
}

model CommunityComment {
  id             String        @id @default(uuid())
  organizationId String
  postId         String
  authorId       String
  authorName     String
  authorRole     UserRoleType
  tenantId       String?
  content        String        @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([organizationId])
  @@map("community_comments")
}

model MarketplaceListing {
  id             String                   @id @default(uuid())
  organizationId String
  propertyId     String
  sellerId       String
  sellerName     String
  sellerRole     UserRoleType
  sellerPhone    String?
  tenantId       String?
  title          String                   @db.VarChar(255)
  description    String                   @db.Text
  price          Decimal                  @db.Decimal(10, 2)
  isNegotiable   Boolean                  @default(false)
  category       MarketplaceCategory      @default(OTHER)
  condition      MarketplaceItemCondition @default(GOOD)
  status         MarketplaceListingStatus @default(ACTIVE)
  images         String[]                 @default([])
  locationNote   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seller         User                     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  tenant         Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([organizationId, propertyId, status, createdAt])
  @@index([propertyId, status])
  @@index([sellerId, createdAt])
  @@map("marketplace_listings")
}

model ServiceRequest {
  id                  String                 @id @default(uuid())
  organizationId      String
  propertyId          String
  requesterId         String
  tenantId            String?
  serviceCategory     ServiceRequestCategory @default(OTHER)
  priority            ServiceRequestPriority @default(MEDIUM)
  status              ServiceRequestStatus   @default(PENDING)
  title               String                 @db.VarChar(255)
  description         String                 @db.Text
  requesterName       String
  requesterRole       UserRoleType
  contactPhone        String

  // Location targeting (PG Room, Rental Unit, or general locationDetails)
  roomId              String?
  rentalUnitId        String?
  locationDetails     String?

  // Scheduling & Assignment
  preferredSlot       ServiceRequestSlot     @default(ANYTIME)
  preferredDate       DateTime?
  scheduledDate       DateTime?
  assignedStaffId     String?
  assignedVendorName  String?
  assignedVendorPhone String?

  // Financial & Cost Tracking
  estimatedCost       Decimal?               @db.Decimal(10, 2)
  actualCost          Decimal?               @db.Decimal(10, 2)
  isPaidByTenant      Boolean                @default(false)

  // Resolution & Lifecycle Timestamps
  resolutionNotes     String?                @db.Text
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  deletedAt           DateTime?

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property            Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requester           User                   @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  tenant              Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  room                Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rentalUnit          RentalUnit?            @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  assignedStaff       StaffMember?           @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([organizationId, propertyId, status, createdAt])
  @@index([propertyId, status])
  @@index([requesterId, createdAt])
  @@index([tenantId])
  @@index([assignedStaffId])
  @@map("service_requests")
}



