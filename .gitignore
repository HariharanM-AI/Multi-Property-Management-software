# ==============================================================================
# PropertyOS — Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Testing & Code Coverage
coverage/
**/coverage/
*.lcov
.nyc_output
test-results/

# Production Builds & Artifacts
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/

# Environment Variables & Secrets (CRITICAL: Do NOT remove)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*secret*
*credential*
id_rsa*
id_ecdsa*
id_ed25519*

# IDE, Editor & OS Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Turborepo & Build Cache
.turbo/
**/.turbo/
.cache/
**/.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
**/*.tsbuildinfo

# Prisma Local Database / SQLite / Migrations artifacts
*.db
*.db-journal
*.sqlite
*.sqlite3
*.dump
prisma/migrations/dev.db

# Storage, Uploads & Scratch Data
uploads/
**/uploads/
scratch/
**/scratch/
.tempmediaStorage/
tmp/
temp/

# Neon Context
.neon

# Agent Workspace & Skills
.agents/
skills-lock.json
